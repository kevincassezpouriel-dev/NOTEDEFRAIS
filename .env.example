# --- Base de données PostgreSQL ---
# Local (docker compose) :
DATABASE_URL="postgresql://qr:qr_password@localhost:5432/qrplatform"
# Neon / Supabase (gratuit) : copier l'URL de connexion fournie

# --- Sécurité ---
# Mot de passe de l'interface admin
ADMIN_PASSWORD="changez-moi"
# Secret de signature des sessions (générer avec : openssl rand -hex 32)
SESSION_SECRET="changez-moi-64-caracteres-aleatoires"

# --- Application ---
# URL publique du site (utilisée pour générer le contenu des QR codes)
APP_BASE_URL="https://monsite.com"

# --- Géolocalisation (optionnel) ---
# "1" pour désactiver l'appel à ip-api.com (les en-têtes Vercel/Cloudflare
# restent utilisés s'ils sont présents)
GEOIP_DISABLED="0"

# --- RGPD (optionnel) ---
# Durée de rétention des scans en jours (vide = illimité).
# Les scans plus anciens sont supprimés automatiquement à chaque nouveau scan.
RETENTION_DAYS=""
