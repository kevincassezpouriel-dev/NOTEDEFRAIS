# --- Base de données PostgreSQL ---
# Local (docker compose) :
DATABASE_URL="postgresql://qr:qr_password@localhost:5432/qrplatform"
# Neon / Supabase (gratuit) : copier l'URL de connexion fournie

# --- Sécurité ---
# Mot de passe de l'interface admin
ADMIN_PASSWORD="changez-moi"
# Secret de signature des sessions (générer avec : openssl rand -hex 32)
SESSION_SECRET="changez-moi-64-caracteres-aleatoires"

# --- Application ---
# URL publique du site (utilisée pour générer le contenu des QR codes)
APP_BASE_URL="https://monsite.com"

# --- Géolocalisation (optionnel) ---
# "1" pour désactiver l'appel à ip-api.com (les en-têtes Vercel/Cloudflare
# restent utilisés s'ils sont présents)
GEOIP_DISABLED="0"

# --- RGPD (optionnel) ---
# Durée de rétention des scans en jours (vide = illimité).
# Les scans plus anciens sont supprimés automatiquement à chaque nouveau scan.
RETENTION_DAYS=""

# --- IA (optionnel — génération de posts + analyse d'audience) ---
# Clé API Anthropic : console.anthropic.com (facturation à l'usage)
ANTHROPIC_API_KEY=""
# Modèles optimisés coût/qualité (laisser vide pour les défauts) :
#   écriture des posts (défaut claude-sonnet-5 — qualité quasi-Opus, ~3x moins cher)
AI_MODEL_WRITE=""
#   analyse & apprentissages (défaut claude-haiku-4-5 — 5x moins cher, tâche mécanique)
AI_MODEL_ANALYZE=""
# Forcer un seul modèle partout (surclasse les deux ci-dessus). Ex. pour le
# minimum absolu : AI_MODEL="claude-haiku-4-5"
AI_MODEL=""

# --- Génération d'IMAGES par IA (optionnel — « claude design ») ---
# Active le bouton « ✨ Générer une image (IA) » sur chaque post : une vraie
# image de fond artistique, à la charte, générée depuis un prompt. Sans clé,
# l'app utilise ses fonds graphiques générés + l'upload de photo/meme.
# Contrat compatible OpenAI Images (beaucoup de fournisseurs le répliquent).
IMAGE_API_KEY=""
# Endpoint (défaut : https://api.openai.com/v1/images/generations)
IMAGE_API_URL=""
# Modèle (défaut : gpt-image-1)
IMAGE_API_MODEL=""
# Taille (défaut : 1024x1024)
IMAGE_API_SIZE=""

# --- E-mail marketing (optionnel) ---
# Clé Resend (resend.com — 3 000 e-mails/mois gratuits, domaine à vérifier)
RESEND_API_KEY=""
# Adresse d'expédition des campagnes, ex. « Minggle <contact@minggle.fr> »
# (le domaine doit être vérifié dans Resend)
EMAIL_FROM=""
# Clé optionnelle exigée sur POST /api/contacts/subscribe (branché sur l'app)
CONTACTS_API_KEY=""

# --- Publication automatique sur les réseaux sociaux (optionnel) ---
# URL de webhook Zapier / Make / IFTTT / Buffer appelée à chaque publication
# de post (voir README, section « Publication automatique »)
SOCIAL_WEBHOOK_URL=""

# --- Autopilote marketing (optionnel) ---
# "1" = chaque lundi 9h (cron Vercel), Claude analyse les stats, rédige un
# post, le publie sur /news et le relaie aux réseaux via le webhook.
AUTOPILOT=""
# Secret de protection de l'endpoint cron (généré ou choisi par vous ;
# Vercel l'envoie automatiquement en en-tête Authorization)
CRON_SECRET=""
