# --- Base de données PostgreSQL ---
# Local (docker compose) :
DATABASE_URL="postgresql://qr:qr_password@localhost:5432/qrplatform"
# Neon / Supabase (gratuit) : copier l'URL de connexion fournie

# --- Sécurité ---
# Mot de passe de l'interface admin
ADMIN_PASSWORD="changez-moi"
# Secret de signature des sessions (générer avec : openssl rand -hex 32)
SESSION_SECRET="changez-moi-64-caracteres-aleatoires"

# --- Application ---
# URL publique du site (utilisée pour générer le contenu des QR codes)
APP_BASE_URL="https://monsite.com"

# --- Géolocalisation (optionnel) ---
# "1" pour désactiver l'appel à ip-api.com (les en-têtes Vercel/Cloudflare
# restent utilisés s'ils sont présents)
GEOIP_DISABLED="0"

# --- RGPD (optionnel) ---
# Durée de rétention des scans en jours (vide = illimité).
# Les scans plus anciens sont supprimés automatiquement à chaque nouveau scan.
RETENTION_DAYS=""

# --- IA (optionnel — génération de posts + analyse d'audience) ---
# Clé API Anthropic : console.anthropic.com (facturation à l'usage)
ANTHROPIC_API_KEY=""
# Modèle (défaut : claude-opus-4-8)
AI_MODEL=""

# --- Publication automatique sur les réseaux sociaux (optionnel) ---
# URL de webhook Zapier / Make / IFTTT / Buffer appelée à chaque publication
# de post (voir README, section « Publication automatique »)
SOCIAL_WEBHOOK_URL=""

# --- Autopilote marketing (optionnel) ---
# "1" = chaque lundi 9h (cron Vercel), Claude analyse les stats, rédige un
# post, le publie sur /news et le relaie aux réseaux via le webhook.
AUTOPILOT=""
# Secret de protection de l'endpoint cron (généré ou choisi par vous ;
# Vercel l'envoie automatiquement en en-tête Authorization)
CRON_SECRET=""
