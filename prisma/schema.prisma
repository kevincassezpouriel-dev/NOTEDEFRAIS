generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  ACQUISITION — QR codes & liens trackés
//  Un QR = un point d'acquisition (un flyer, un lieu, un canal).
//  C'est lui qui répond à « quel flyer, quel lieu convertit ».
// ============================================================

/// Un asset tracké : un QR code OU un lien de suivi. Les URLs de destination
/// sont modifiables sans changer le QR/lien : il pointe toujours vers
/// /r/{slug} (ou /l/{slug}).
model QrCode {
  id           String       @id @default(cuid())
  name         String // ex. « Flyer campus Roberval », « Affiche gare »
  slug         String       @unique
  type         String       @default("qr") // "qr" | "link"
  channel      String? // flyer | instagram | affiche | terrain…
  appStoreUrl  String
  playStoreUrl String
  fallbackUrl  String
  logo         String? // logo au centre du QR, stocké en data-URL (max ~200 Ko)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  scans        ScanEvent[]
  conversions  Conversion[]
  annonces     Annonce[]
}

/// Un scan = un passage par /r/{slug}. IP anonymisée avant stockage (RGPD).
model ScanEvent {
  id           String   @id @default(cuid())
  qrCode       QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  qrCodeId     String
  createdAt    DateTime @default(now())
  ipAnonymized String? // IPv4 : dernier octet à 0 — IPv6 : tronquée à /48
  country      String?
  countryCode  String?
  city         String?
  latitude     Float? // arrondi à 1 décimale (~11 km) : niveau ville, pas individu
  longitude    Float?
  deviceType   String // iphone | ipad | android | windows | mac | linux | other
  os           String?
  browser      String?
  language     String?
  referrer     String?
  redirectedTo String // appstore | playstore | fallback

  @@index([qrCodeId, createdAt])
  @@index([createdAt])
  @@index([referrer])
}

/// Conversion post-scan (installation confirmée par l'app).
model Conversion {
  id        String   @id @default(cuid())
  qrCode    QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  qrCodeId  String?
  type      String   @default("install")
  platform  String? // ios | android | web
  source    String? // utm_source d'origine
  createdAt DateTime @default(now())

  @@index([qrCodeId, createdAt])
}

// ============================================================
//  CRM TERRAIN — le cœur de l'opération Compiègne
//  Propriétaire → Annonce → Candidature → Transmission → Installation
// ============================================================

/// Le contact humain. Un propriétaire peut avoir plusieurs annonces.
/// Ses coordonnées ne sont JAMAIS exposées publiquement.
model Proprietaire {
  id       String  @id @default(cuid())
  nom      String
  telephone String?
  email    String?

  /// coloc_existante | proprietaire_particulier | proprietaire_multi | agence | residence
  type   String @default("proprietaire_particulier")
  /// leboncoin | pap | roomlala | facebook | terrain | bouche_a_oreille | entrant_spontane | autre
  source String @default("terrain")
  quartier String?

  /// a_contacter | contacte | relance_1 | relance_2 | accord_obtenu | refus | injoignable
  statut String @default("a_contacter")

  datePremierContact DateTime?
  dateDerniereAction DateTime?
  dateRelancePrevue  DateTime?

  accordEcrit  Boolean @default(false)
  accordPreuve String? // copie du message d'accord

  /// LE champ clé : ce que le propriétaire cherche comme personne, et ce qui
  /// ne passerait pas. C'est lui qui alimente le score d'affinité.
  briefRecherche String?
  notes          String?

  createdAt DateTime   @default(now())
  annonces  Annonce[]
  documents Document[]

  @@index([statut])
  @@index([dateRelancePrevue])
}

/// Une chambre à pourvoir. Publique (sans aucune donnée propriétaire).
model Annonce {
  id             String       @id @default(cuid())
  proprietaire   Proprietaire @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  proprietaireId String

  titre String
  slug  String @unique

  /// ID du logement dans l'app Minggle — le pont entre les deux systèmes.
  referenceExterne String?

  quartier      String?
  adresseApprox String? // jamais l'adresse exacte en public

  loyer          Int?
  charges        Int?
  caution        Int?
  surfaceChambre Float?
  surfaceTotale  Float?
  meublee        Boolean @default(false)

  dateDispo DateTime?
  dureeMin  String?

  nbColocataires     Int?
  profilColocataires String? // qui vit déjà là
  description        String?
  equipements        String?
  photos             String? // URLs séparées par des retours à la ligne

  /// brouillon | en_ligne | pourvue | archivee
  statut      String    @default("brouillon")
  publishedAt DateTime?

  /// QR/lien tracké dédié à cette annonce (créé automatiquement).
  qrCode   QrCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  qrCodeId String?

  createdAt     DateTime       @default(now())
  candidatures  Candidature[]
  transmissions Transmission[]

  @@index([statut])
  @@index([proprietaireId])
}

/// Un candidat qui postule sur une annonce (via le formulaire public).
model Candidature {
  id        String  @id @default(cuid())
  annonce   Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  annonceId String

  nom       String
  email     String
  telephone String?

  /// etudiant | jeune_actif | alternant | stagiaire | autre
  statutPro      String  @default("etudiant")
  ecoleEmployeur String?
  budgetMax      Int?
  dateDispo      DateTime?
  dureeSouhaitee String?
  /// oui | non | a_verifier
  garant         String  @default("a_verifier")

  // --- Profil d'affinités : le cœur du produit ---
  /// couche_tot | couche_tard | flexible
  rythme  String @default("flexible")
  /// 1 (peu regardant) → 5 (maniaque)
  menage  Int    @default(3)
  /// jamais | parfois | souvent
  invites String @default("parfois")
  /// 1 (jamais) → 5 (très festif)
  fetes   Int    @default(3)
  fumeur  Boolean @default(false)
  animaux Boolean @default(false)

  /// « pourquoi cette coloc en particulier » — obligatoire, min 100 caractères
  motivation String

  /// Score saisi par l'opérateur (1-5) + score suggéré automatiquement
  scoreAffinite Int?
  scoreSuggere  Int?
  scoreRaisons  String? // explications du score suggéré, une par ligne

  /// a_qualifier | qualifie | transmis | installe | ecarte | sans_suite
  statut String @default("a_qualifier")

  /// Rempli automatiquement depuis le tracking QR (utm_source / QR scanné)
  campagneSource String?

  notesQualification String?

  createdAt     DateTime       @default(now())
  transmissions Transmission[]
  documents     Document[]

  @@index([statut])
  @@index([annonceId, statut])
  @@index([createdAt])
}

/// La traçabilité : une ligne = un envoi d'un candidat à un propriétaire.
model Transmission {
  id            String      @id @default(cuid())
  candidature   Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  candidatureId String
  annonce       Annonce     @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  annonceId     String

  /// whatsapp | sms | mail | appel | autre
  canal String @default("whatsapp")

  /// en_attente | visite_prevue | visite_faite | accepte_installe |
  /// refuse_par_coloc | refuse_par_candidat | sans_reponse
  resultat String @default("en_attente")

  dateResultat DateTime?
  commentaire  String?

  createdAt DateTime @default(now())

  @@index([resultat])
  @@index([annonceId])
  @@index([createdAt])
}

/// Pièces jointes : accord de publication, fiche candidat, dossier locataire.
model Document {
  id             String        @id @default(cuid())
  proprietaire   Proprietaire? @relation(fields: [proprietaireId], references: [id], onDelete: Cascade)
  proprietaireId String?
  candidature    Candidature?  @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  candidatureId  String?

  /// accord_publication | fiche_candidat | dossier_locataire | autre
  type       String @default("autre")
  nomFichier String
  url        String

  envoyeLe   DateTime?
  canalEnvoi String?

  createdAt DateTime @default(now())

  @@index([proprietaireId])
}

/// Journal horodaté : chaque action marquante du CRM (contact, accord,
/// publication, qualification, transmission, résultat) y est tracée.
model Action {
  id        String   @id @default(cuid())
  type      String // proprietaire.contacte | annonce.publiee | candidature.qualifiee | transmission.envoyee…
  actor     String   @default("human") // human | system
  title     String
  detail    String?
  status    String   @default("done") // done | pending
  refType   String? // proprietaire | annonce | candidature | transmission
  refId     String?
  createdAt DateTime @default(now())

  @@index([refType, refId])
  @@index([createdAt])
}

// ============================================================
//  E-MAIL — relances propriétaires & communication candidats
// ============================================================

/// Contact e-mail (inscrit via l'app, importé, ou ajouté à la main).
model Contact {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  source         String? // app | import | manuel
  subscribed     Boolean      @default(true)
  attributes     String? // profil JSON libre issu du CSV : { genre, age, statut, … }
  createdAt      DateTime     @default(now())
  unsubscribedAt DateTime?
  events         EmailEvent[]

  @@index([subscribed])
}

/// Campagne e-mail (générée par l'IA ou écrite à la main).
model EmailCampaign {
  id          String       @id @default(cuid())
  subject     String
  preheader   String?
  content     String // blocs JSON : { intro, sections[{title,body}], ctaLabel, ctaUrl }
  status      String       @default("draft") // draft | sent
  aiGenerated Boolean      @default(false)
  createdAt   DateTime     @default(now())
  sentAt      DateTime?
  sentCount   Int          @default(0)
  events      EmailEvent[]
}

/// Ouverture ou clic — unique par contact/campagne/type (taux uniques).
model EmailEvent {
  id         String        @id @default(cuid())
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String
  type       String // open | click
  createdAt  DateTime      @default(now())

  @@unique([campaignId, contactId, type])
  @@index([campaignId, type])
}

/// Liste ciblée : règles de filtre sur les attributs de profil des contacts.
model Segment {
  id        String   @id @default(cuid())
  name      String
  rules     String // JSON : [{ key, op: contient|egal|min|max, value }]
  createdAt DateTime @default(now())
}

/// Réglages clé/valeur (identité de marque pour les e-mails, etc.).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
